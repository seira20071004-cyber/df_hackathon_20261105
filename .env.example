# Set true explicitly to enable fictional local demo accounts.
BRIDGE_DEMO=true
# For Firebase mode, set BRIDGE_DEMO=false and configure these:
# Enable only after enabling the Google provider and registering the app domain in Firebase Auth.
BRIDGE_GOOGLE_SIGN_IN=false
FIREBASE_PROJECT_ID=
FIREBASE_WEB_API_KEY=
GOOGLE_APPLICATION_CREDENTIALS=
GEMINI_MODEL=gemini-2.5-flash
# Optional independent review model. Defaults to GEMINI_MODEL.
GEMINI_REVIEW_MODEL=
# Interactive manuals do not require image generation.
GEMINI_GENERATE_IMAGES=false
# Optional semantic retrieval; select a model supported by your provider.
GEMINI_EMBEDDING_MODEL=
GEMINI_SIMILARITY_MIN=0.72
GEMINI_IMAGE_MODEL=gemini-2.5-flash-image
# Vertex AI uses ADC. Set both values and choose models supported in this location.
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=
# Use a private bucket and a pinned Layout Parser processor version.
BRIDGE_DOCUMENT_BUCKET=
BRIDGE_DOCUMENT_PROCESSOR=
# Enable only after reviewing the selected processor, model, retention, and regions.
BRIDGE_DOCUMENT_AI_APPROVED=false
BRIDGE_ALLOW_CONFIDENTIAL_PDF=false
# Explicit opt-in for fictional demos in a production build. Never use with real data.
BRIDGE_ALLOW_PUBLIC_DEMO=false
# Production defaults to fail-closed unless google-dlp completes successfully.
BRIDGE_SENSITIVE_PROVIDER=local
BRIDGE_PRIVACY_STRICT=false
BRIDGE_DLP_PROJECT=
# Optional Firebase App Check backend enforcement. Requires configured clients.
BRIDGE_APP_CHECK_ENFORCE=false
BRIDGE_APP_CHECK_APP_IDS=
# Comma-separated exact HTTPS origins, if a reverse proxy changes the internal origin.
BRIDGE_ALLOWED_ORIGINS=
BRIDGE_USER_REQUESTS_PER_MINUTE=90
BRIDGE_ORG_REQUESTS_PER_MINUTE=900
BRIDGE_AI_CALLS_PER_MINUTE=60
BRIDGE_AI_CONCURRENCY=4
# Browser App Check (reCAPTCHA Enterprise). Disabled until Cloud/Firebase setup is reviewed.
BRIDGE_APP_CHECK_CLIENT_ENABLED=false
BRIDGE_APP_CHECK_SITE_KEY=
FIREBASE_WEB_APP_ID=
