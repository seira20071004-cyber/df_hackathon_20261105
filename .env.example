# Set true explicitly to enable fictional local demo accounts.
BRIDGE_DEMO=true
# For Firebase mode, set BRIDGE_DEMO=false and configure these:
FIREBASE_PROJECT_ID=
FIREBASE_WEB_API_KEY=
GOOGLE_APPLICATION_CREDENTIALS=
# Server only. Optional in local demo.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_IMAGE_MODEL=gemini-2.5-flash-image
# For Google Cloud Vertex AI, set provider=vertex and choose supported models.
GEMINI_PROVIDER=developer
GOOGLE_CLOUD_PROJECT=
# On Cloud Run, use the runtime service account (no API key or JSON key file).
# Local ADC must be configured separately. Leave empty when using API-key authentication.
GEMINI_VERTEX_AUTH=
