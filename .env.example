# Set true explicitly to enable fictional local demo accounts.
BRIDGE_DEMO=true
# For Firebase mode, set BRIDGE_DEMO=false and configure these:
FIREBASE_PROJECT_ID=
FIREBASE_WEB_API_KEY=
GOOGLE_APPLICATION_CREDENTIALS=
# Server only. Optional in local demo.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_IMAGE_MODEL=gemini-2.5-flash-image
